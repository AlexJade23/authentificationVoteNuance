# Base de données
DATABASE_URL=postgresql://authuser:authpassword@localhost:5432/authdb

# Sécurité (générer avec: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here-generate-with-openssl
ENCRYPTION_KEY=your-encryption-key-here-generate-with-openssl

# TOTP
TOTP_ISSUER=DecisionCollective

# Email SMTP
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=auth@decision-collective.fr

# URLs
BASE_URL=https://auth.decision-collective.fr
FRONTEND_URL=https://app.decision-collective.fr

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
